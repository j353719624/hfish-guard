#!/bin/bash
set -u
BIN="/vol2/@appcenter/hfish-guard/bin"
DATA="/vol2/@appdata/hfish-guard"
LOG="${DATA}/guard.log"

case "${1:-start}" in
  start)
    if pgrep -f "hfish-guard/bin/guard.py" >/dev/null 2>&1; then
      echo already-running
    else
      cd "${BIN}" && setsid /usr/bin/python3 guard.py >>"${LOG}" 2>&1 &
      echo started
    fi ;;
  stop)
    pkill -f "hfish-guard/bin/guard.py" 2>/dev/null
    echo stopped ;;
  restart)
    pkill -f "hfish-guard/bin/guard.py" 2>/dev/null
    sleep 1
    cd "${BIN}" && setsid /usr/bin/python3 guard.py >>"${LOG}" 2>&1 &
    echo restarted ;;
  status)
    if pgrep -f "hfish-guard/bin/guard.py" >/dev/null 2>&1; then
      echo running
    else
      echo stopped
    fi ;;
  *) echo "usage: $0 start|stop|restart|status" ;;
esac
